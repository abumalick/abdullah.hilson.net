{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abdullah-hilson-net",
  "account_id": "9ab550becc556ce60d4250bfdc48224c",
  "compatibility_date": "2025-06-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "abdullah.hilson.net", "custom_domain": true },
    { "pattern": "hilson.net", "custom_domain": true },
    { "pattern": "www.hilson.net", "custom_domain": true }
  ]
}
